# ============================================================
# KAHIS Terminology App — .gitignore
# ============================================================

# ----- Database files (ignore 200MB raw .db, allow compressed .db.gz < 100MB) -----
*.db
*.db.building

# ----- Backup files (ignore raw .db backups, allow compressed .db.gz backups) -----
backup/*.db

# ----- macOS system files ----------------------------------
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*

# ----- Python -----------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
pip-log.txt

# ----- Logs & temp -----------------------------------------
*.log
*.tmp
*.swp
*.swo
*~

# ----- Editor / IDE ----------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ----- OS & environment ------------------------------------
Thumbs.db
.env
.env.local
