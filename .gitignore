# ============================================================
# KAHIS Terminology App — .gitignore
# ============================================================

# ----- Database files (exclude all .db and .db.gz from GitHub) -----
*.db
*.db.gz
*.db.building
releases/*.db
releases/*.db.gz

# ----- Raw Source Files (exclude large RF2/SA-PDT sources, track 4_KU-Custom) -----
sources/1_SA-PDT/
sources/2_VSCT/
sources/3_SCT-Int/

# ----- Backup & Archive binary files -----------------------
backup/*.db
backup/*.db.gz
archive/backup/

# ----- macOS system files ----------------------------------
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*

# ----- Python -----------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
pip-log.txt

# ----- Logs & temp -----------------------------------------
*.log
*.tmp
*.swp
*.swo
*~

# ----- Editor / IDE ----------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ----- OS & environment ------------------------------------
Thumbs.db
.env
.env.local

# ----- Firebase Cache -----
.firebase/
